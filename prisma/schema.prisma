datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Roles
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  TEAM_LEADER
  AGENT
  MARKETING_EXECUTIVE
  BUILDER_PARTNER
}

// Lead Statuses
enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
}

// Lead Sources
enum LeadSource {
  GOOGLE_ADS
  FACEBOOK_ADS
  INSTAGRAM
  WHATSAPP
  PROPERTY_FINDER
  BAYUT
  ORGANIC_SEO
  REFERRALS
}

// Property Status
enum PropertyStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

// Site Visit Status
enum VisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

// Deal Status
enum DealStatus {
  LEAD
  SITE_VISIT
  NEGOTIATION
  BOOKING
  AGREEMENT
  CLOSURE
}

// Commission Status
enum CommissionStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

// Communication Channel
enum CommChannel {
  WHATSAPP
  EMAIL
  SMS
}

// --- Tenant Isolation ---
model Tenant {
  id                 String               @id @default(uuid())
  name               String
  subdomain          String               @unique
  customDomain       String?              @unique
  logoUrl            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  
  // Relations
  users              User[]
  teams              Team[]
  builders           Builder[]
  projects           Project[]
  properties         Property[]
  leads              Lead[]
  siteVisits         SiteVisit[]
  deals              Deal[]
  commissions        Commission[]
  campaigns          MarketingCampaign[]
  communicationLogs  CommunicationLog[]
  documents          Document[]
  auditLogs          AuditLog[]

  @@index([subdomain])
}

// --- User Management ---
model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String
  name               String
  phone              String?
  role               UserRole          @default(AGENT)
  isActive           Boolean           @default(true)
  twoFactorEnabled   Boolean           @default(false)
  twoFactorSecret    String?
  profilePhoto       String?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  teamId             String?
  team               Team?             @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams           Team[]            @relation("TeamLeader")

  leads              Lead[]            @relation("LeadAssignment")
  siteVisits         SiteVisit[]       @relation("VisitAssignment")
  deals              Deal[]            @relation("AgentDeals")
  auditLogs          AuditLog[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([email])
}

// --- Team Management ---
model Team {
  id                 String            @id @default(uuid())
  name               String
  leaderId           String?
  leader             User?             @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  members            User[]            @relation("TeamMembers")
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
}

// --- Builder Management ---
model Builder {
  id                 String            @id @default(uuid())
  name               String
  contactEmail       String?
  contactPhone       String?
  companyDetails     Json?             
  commissionRules    Json?             
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  projects           Project[]
  properties         Property[]
  deals              Deal[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
}

// --- Project Management ---
model Project {
  id                 String            @id @default(uuid())
  name               String
  builderId          String
  builder            Builder           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  city               String
  location           String
  description        String?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  towers             Tower[]
  properties         Property[]
  leads              Lead[]
  campaigns          MarketingCampaign[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([builderId])
}

model Tower {
  id                 String            @id @default(uuid())
  name               String
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  properties         Property[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([projectId])
}

// --- Property Database ---
model Property {
  id                 String            @id @default(uuid())
  unitNumber         String
  floor              Int
  towerId            String
  tower              Tower             @relation(fields: [towerId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builderId          String
  builder            Builder           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  status             PropertyStatus    @default(AVAILABLE)
  price              Decimal           @db.Decimal(12, 2)
  currency           String            @default("AED")
  beds               Int
  baths              Int
  sqft               Decimal           @db.Decimal(8, 2)
  floorPlanUrl       String?
  brochureUrl        String?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  deals              Deal[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
}

// --- Lead Database ---
model Lead {
  id                 String            @id @default(uuid())
  name               String
  email              String?
  phone              String
  source             LeadSource        @default(ORGANIC_SEO)
  status             LeadStatus        @default(NEW)
  budget             Decimal?          @db.Decimal(12, 2)
  locationPreference String?
  notes              Json?             
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assignedToId       String?
  assignedTo         User?             @relation("LeadAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  siteVisits         SiteVisit[]
  deals              Deal[]
  communicationLogs  CommunicationLog[]
  documents          Document[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
  @@index([status])
  @@index([phone])
}

// --- Site Visits ---
model SiteVisit {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId       String
  assignedTo         User              @relation("VisitAssignment", fields: [assignedToId], references: [id], onDelete: Cascade)
  
  scheduledAt        DateTime
  status             VisitStatus       @default(SCHEDULED)
  gpsCheckIn         Json?             
  outcome            String?
  notes              String?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
  @@index([scheduledAt])
}

// --- Deal & Pipeline Management ---
model Deal {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  builderId          String
  builder            Builder           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  agentId            String
  agent              User              @relation("AgentDeals", fields: [agentId], references: [id], onDelete: Cascade)
  
  bookingAmount      Decimal           @db.Decimal(12, 2)
  status             DealStatus        @default(LEAD)
  paymentMilestones  Json?             
  contractUrl        String?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  commission         Commission?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([status])
}

// --- Commissions Ledger ---
model Commission {
  id                 String            @id @default(uuid())
  dealId             String            @unique
  deal               Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  agentAmount        Decimal           @db.Decimal(12, 2)
  teamAmount         Decimal           @db.Decimal(12, 2)
  builderAmount      Decimal           @db.Decimal(12, 2)
  status             CommissionStatus  @default(PENDING_APPROVAL)
  approvalWorkflow   Json?             
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([status])
}

// --- Marketing Campaigns ---
model MarketingCampaign {
  id                 String            @id @default(uuid())
  name               String
  source             LeadSource
  cost               Decimal           @db.Decimal(10, 2)
  budget             Decimal           @db.Decimal(10, 2)
  startDate          DateTime
  endDate            DateTime?
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  projects           Project[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
}

// --- Communication Logs ---
model CommunicationLog {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel            CommChannel
  direction          String            
  content            String
  status             String            
  metadata           Json?             
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())

  @@index([tenantId])
  @@index([leadId])
}

// --- Documents ---
model Document {
  id                 String            @id @default(uuid())
  name               String
  s3Key              String
  s3Url              String
  fileType           String
  version            Int               @default(1)
  size               Int
  
  leadId             String?
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
}

// --- Audit & Compliance Logs ---
model AuditLog {
  id                 String            @id @default(uuid())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  action             String            
  ipAddress          String?
  userAgent          String?
  details            Json?             
  
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())

  @@index([tenantId])
  @@index([createdAt])
}
